{
  "name": "@intgetion/ugc",
  "version": "0.1.0",
  "description": "UGC creative tests for INTGETION JOB LIST: creator profiles, campaign briefs and versions, invites, submissions, shipments, the room, disputes, crypto escrow deposits, payouts and refunds, and the assistant tools.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/modules/ugc/service/index.ts",
    "./config": "./src/config/ugc.ts",
    "./ports": "./src/ports.ts",
    "./server": "./src/server/app.ts",
    "./db": "./src/db/owned.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intgetion/kit": "github:theonyxiesss/intgetion-kit#v0.3.1",
    "drizzle-orm": "^0.45.3",
    "pino": "10.4.0",
    "postgres": "^3.4.9",
    "tsx": "^4.20.0",
    "zod": "^4.6.5",
    "@intgetion/billing": "github:theonyxiesss/intgetion-billing#v0.2.0",
    "@intgetion/users": "github:theonyxiesss/intgetion-users#v0.1.1",
    "@intgetion/companies": "github:theonyxiesss/intgetion-companies#v0.1.1",
    "@intgetion/notifications": "github:theonyxiesss/intgetion-notifications#v0.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
